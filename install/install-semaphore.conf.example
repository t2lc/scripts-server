# ========================================
# Configuration de install-semaphore.sh
#
# Copier ce fichier en install-semaphore.conf (à côté du script),
# puis adapter les valeurs. Ne pas versionner le fichier rempli.
# ========================================

# "latest" ou une version précise, ex. "2.20.2"
SEMAPHORE_VERSION="latest"

# Compte administrateur créé à la première installation
ADMIN_LOGIN="admin"
ADMIN_NAME="Administrator"
# Le script refuse l'adresse d'exemple @example.com
ADMIN_EMAIL="admin@example.com"

TIMEZONE="Europe/Paris"
